    <Trigger Name="День рождения">
        <AIRequest>Поздравь меня с Днём Рождения.</AIRequest>
		<Pics>Setup/Pics/Compliments.txt</Pics>
        <Date>28.10</Date>
        <Time>14:X</Time>
		<RandomTime>RANDOM-SMALL-HOUR</RandomTime>
    </Trigger>
    <Trigger Name="Новый год">
        <AIRequest>Поздравь меня с Новым Годом.</AIRequest>
		<Pics>Setup/Pics/Compliments.txt</Pics>
        <Date>31.12</Date>
        <Time>22:X</Time>
		<RandomTime>RANDOM-SMALL-HOUR</RandomTime>
    </Trigger>
</Triggers>
